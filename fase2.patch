+function paguRingkas(n) {
+  n = Math.round(Number(n));
+  const f = (v, suf) => (Math.round(v * 10) / 10).toLocaleString('id-ID') + suf;
+  if (n >= 1e9) return f(n / 1e9, 'M');
+  if (n >= 1e6) return f(n / 1e6, 'jt');
+  if (n >= 1e3) return f(n / 1e3, 'rb');
+  return String(n);
