+function rupiahRingkasKb(n) {
+  n = Math.abs(Math.round(n));
+  const f = (v, suf) => 'Rp ' + (Math.round(v * 10) / 10).toLocaleString('id-ID') + ' ' + suf;
+  if (n >= 1e9) return f(n / 1e9, 'M');
